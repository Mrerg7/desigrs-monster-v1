---
import '../styles/global.css';
import {
  SITE,
  HERO_IMAGE,
  OG_IMAGE,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  ACQUISITION_MAILTO,
  DOMAIN_REVIEWS,
  DOMAIN_AGGREGATE_RATING,
} from '../config/site';

interface FaqItem {
  question: string;
  answer: string;
}

interface ProcessItem {
  title: string;
  body: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Override auto-derived canonical (use site root for error pages). */
  canonical?: string;
  faqs?: FaqItem[];
  process?: ProcessItem[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
  canonical,
  faqs = [],
  process = [],
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = canonical ?? new URL(pathname, `${SITE.url}/`).href;
const isHome = canonicalURL === `${SITE.url}/`;

const productNode = {
  '@type': 'Product',
  '@id': `${SITE.url}/#product`,
  name: 'desigrs.monster Premium Domain Name',
  description:
    'Brandable 7-letter .monster domain name for sale — built for AI design tools, creative studios, generative design platforms, and design-led brands. Asking price $6,500 USD.',
  url: SITE.url,
  image: ogImage,
  sku: SITE.sku,
  category: 'Premium Domain Name',
  itemCondition: 'https://schema.org/NewCondition',
  brand: {
    '@type': 'Brand',
    name: SITE.name,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: DOMAIN_AGGREGATE_RATING.ratingValue,
    reviewCount: DOMAIN_AGGREGATE_RATING.reviewCount,
    bestRating: DOMAIN_AGGREGATE_RATING.bestRating,
    worstRating: DOMAIN_AGGREGATE_RATING.worstRating,
  },
  review: DOMAIN_REVIEWS.map((review) => ({
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: String(review.rating),
      bestRating: DOMAIN_AGGREGATE_RATING.bestRating,
      worstRating: DOMAIN_AGGREGATE_RATING.worstRating,
    },
    author: {
      '@type': 'Person',
      name: review.author,
    },
    datePublished: review.datePublished,
    reviewBody: review.reviewBody,
  })),
  offers: {
    '@type': 'Offer',
    url: `${SITE.url}/`,
    price: String(SITE.askingPrice),
    priceCurrency: 'USD',
    priceValidUntil: '2027-09-25',
    availability: 'https://schema.org/InStock',
    businessFunction: 'https://schema.org/Sell',
    seller: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0.00',
        currency: 'USD',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 1,
          unitCode: 'DAY',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 0,
          unitCode: 'DAY',
        },
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'US',
      },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
      applicableCountry: 'US',
      merchantReturnDays: 0,
    },
  },
};

const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalURL}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE.url}/`,
    },
    ...(isHome
      ? []
      : [
          {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonicalURL,
          },
        ]),
  ],
};

const faqNode =
  !noindex && faqs.length > 0
    ? {
        '@type': 'FAQPage',
        '@id': `${canonicalURL}#faq`,
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const howToNode =
  !noindex && process.length > 0
    ? {
        '@type': 'HowTo',
        '@id': `${canonicalURL}#how-to-buy`,
        name: 'How to buy the desigrs.monster domain name',
        description:
          'Four steps to acquire desigrs.monster securely: inquiry, escrow agreement, funding, and transfer to your registrar.',
        step: process.map((step, index) => ({
          '@type': 'HowToStep',
          position: index + 1,
          name: step.title,
          text: step.body,
        })),
      }
    : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      datePublished: SITE.publishedDate,
      dateModified: SITE.modifiedDate,
      inLanguage: 'en-US',
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage,
        width: OG_IMAGE_WIDTH,
        height: OG_IMAGE_HEIGHT,
      },
    },
    breadcrumbNode,
    ...(noindex ? [] : [productNode]),
    ...(faqNode ? [faqNode] : []),
    ...(howToNode ? [howToNode] : []),
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      description:
        'Owner-operated listing for the premium desigrs.monster domain name, offered for sale directly to buyers and brand builders.',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.keywords.join(', ')} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalURL} />

    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta
      property="og:image:alt"
      content="desigrs.monster — premium design domain for sale"
    />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="desigrs.monster — premium design domain for sale"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link
      rel="preload"
      as="image"
      href={HERO_IMAGE}
      width="1024"
      height="558"
      fetchpriority="high"
    />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/sora-xMQ9uFFYT72X5wkB_18qmnndmSdSnh2BAfO5mnuyOo1lfiQwV6-xo6eeIw.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dmsans-rP2Hp2ywxg089UriCZOIHTWEBlw.woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="atmosphere min-h-dvh overflow-x-hidden antialiased">
    <slot />
  </body>
</html>
