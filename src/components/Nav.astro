---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<a
  href="#main"
  class="sr-only z-50 inline-flex min-h-11 items-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-[var(--color-ink)] focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
>
  Skip to content
</a>

<header class="absolute inset-x-0 top-0 z-30">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-5 py-5 sm:gap-4 sm:px-6 sm:py-6" aria-label="Primary">
    <a href="/" class="group flex min-w-0 items-center gap-3 text-white">
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/20 bg-white/10 font-display text-sm tracking-tight"
        aria-hidden="true"
      >
        DM
      </span>
      <span class="truncate font-display text-base tracking-tight sm:text-lg md:text-xl">{SITE.name}</span>
    </a>

    <div class="flex shrink-0 items-center gap-4 sm:gap-5">
      <a
        href="/#why"
        class="hidden min-h-11 items-center text-sm font-medium text-white/75 transition-colors hover:text-white sm:inline-flex"
      >
        Why this domain
      </a>
      <a
        href="/#faq"
        class="hidden min-h-11 items-center text-sm font-medium text-white/75 transition-colors hover:text-white lg:inline-flex"
      >
        FAQ
      </a>
      <a
        href="/#process"
        class="hidden min-h-11 items-center text-sm font-medium text-white/75 transition-colors hover:text-white lg:inline-flex"
      >
        How it works
      </a>
      <a href={ACQUISITION_MAILTO} class="btn-primary min-h-11 !px-3.5 !py-2.5 text-sm sm:min-h-12 sm:!px-5">
        Acquire
      </a>
    </div>
  </nav>
</header>
