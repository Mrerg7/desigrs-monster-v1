---
interface Props {
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<section id="why" class="relative z-10 scroll-mt-20 px-5 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">
        Why this domain
      </p>
      <h2 class="section-title text-[var(--color-ink)]">
        The name for the AI design era.
      </h2>
      <p class="mt-4 max-w-xl font-serif text-lg leading-relaxed text-[var(--color-ink-soft)]/80">
        Designers are no longer competing with machines — they are directing them. 
        desigrs.monster signals the fusion of human creativity and machine speed.
      </p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {items.map((item, index) => (
        <article class="border-t border-[var(--color-line)] pt-6">
          <p class="mb-3 font-mono text-xs tracking-widest text-[var(--color-mist)]">
            {String(index + 1).padStart(2, '0')}
          </p>
          <h3 class="font-display text-xl tracking-tight text-[var(--color-ink)] sm:text-2xl">
            {item.title}
          </h3>
          <p class="mt-3 max-w-prose text-[0.98rem] leading-relaxed text-[var(--color-ink-soft)]/75">
            {item.body}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
