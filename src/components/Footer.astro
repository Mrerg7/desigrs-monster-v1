---
import { ACQUISITION_MAILTO, SITE } from '../config/site';

interface Props {
  disclaimer: string;
}

const { disclaimer } = Astro.props;
---

<footer id="acquire" class="relative z-10 border-t border-[var(--color-line)] bg-[var(--color-ink)] text-white">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 sm:py-20">
    <!-- Sophisticated domain acquisition CTA -->
    <div class="relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-gradient-to-br from-[#1a0b2e] via-[#0f0a1a] to-[#2e1065] p-8 sm:p-12">
      <div
        class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-[var(--color-accent)]/25 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-28 -left-16 h-64 w-64 rounded-full bg-violet-400/10 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 grid items-center gap-10 lg:grid-cols-[1.25fr_0.85fr]">
        <div>
          <p class="mb-4 text-xs font-extrabold uppercase tracking-[0.2em] text-[var(--color-accent-bright)]">
            Domain available for acquisition
          </p>
          <h2 class="font-display text-3xl tracking-tight sm:text-4xl">
            desigrs.monster — a strategic creative asset
          </h2>
          <p class="mt-4 max-w-xl font-serif text-base leading-relaxed text-white/65 sm:text-lg">
            Positioned at the intersection of design culture, AI collaboration, and immersive media.
            A scarce, memorable .monster domain for studios, platforms, and brands shaping the next
            decade of visual culture. Asking price {SITE.askingPriceLabel} USD — contact for transfer
            logistics and escrow options.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-black/35 p-6 backdrop-blur-xl sm:p-8">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-white/45">
            Asking price
          </p>
          <p class="font-display text-4xl tracking-tight text-white sm:text-5xl">
            {SITE.askingPriceLabel}
            <span class="ml-1 text-lg font-sans font-medium tracking-normal text-white/45 sm:text-xl">USD</span>
          </p>

          <div class="mt-6 border-t border-white/10 pt-6">
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-white/45">
              Acquisition contact
            </p>
            <a
              href={`mailto:${SITE.email}`}
              class="block break-all font-display text-xl tracking-tight text-white transition-colors hover:text-[var(--color-accent-bright)] sm:text-2xl"
            >
              {SITE.email}
            </a>
          </div>

          <a href={ACQUISITION_MAILTO} class="btn-primary mt-6 w-full">
            Inquire about acquisition
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
          <p class="mt-4 text-center text-[11px] tracking-wide text-white/40">
            Confidential inquiries &bull; Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <p class="mt-12 max-w-4xl text-xs leading-relaxed text-white/40">
      {disclaimer}
    </p>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/40 sm:flex-row sm:items-center">
      <p>&copy; 2026 {SITE.name}. All rights reserved.</p>
      <p>Premium domain listing by owner</p>
    </div>
  </div>
</footer>
