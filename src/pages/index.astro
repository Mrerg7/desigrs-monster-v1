---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhySection from '../components/WhySection.astro';
import TrendsSection from '../components/TrendsSection.astro';
import SeoValueSection from '../components/SeoValueSection.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

const site = await getEntry('site', 'default');
if (!site) {
  throw new Error('Missing content entry: site/default');
}
const data = site.data;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Nav />
  <main>
    <Hero
      tagline={data.tagline}
      heroSupport={data.heroSupport}
      trustPoints={data.trustPoints}
    />
    <WhySection items={data.valueProps} />
    <TrendsSection items={data.trends} />
    <SeoValueSection items={data.seoPoints} />
  </main>
  <Footer disclaimer={data.disclaimer} />
</BaseLayout>
