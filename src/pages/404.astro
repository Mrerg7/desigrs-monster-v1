---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout title={`Page not found | ${SITE.name}`} description="The page you requested does not exist." noindex={true}>
  <main class="flex min-h-dvh flex-col items-center justify-center px-5 text-center">
    <p class="mb-4 font-mono text-sm tracking-widest text-[var(--color-mist)]">404</p>
    <h1 class="font-display text-3xl tracking-tight text-[var(--color-ink)] sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-4 max-w-md text-[var(--color-ink-soft)]/75">
      The page you are looking for does not exist or has been moved.
    </p>
    <a href="/" class="btn-primary mt-8">
      Return home
    </a>
  </main>
</BaseLayout>
