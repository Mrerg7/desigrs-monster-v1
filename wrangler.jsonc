{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desigrs-monster-v1",
  "compatibility_date": "2026-08-10",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "desigrs.monster", "custom_domain": true },
    { "pattern": "www.desigrs.monster", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
